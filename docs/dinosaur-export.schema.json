{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:genesis-lab:dinosaur:1",
  "title": "Fictional Genesis Lab dinosaur export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "fictionalLabCreation",
    "creation"
  ],
  "properties": {
    "schema": {
      "const": "genesis-lab/dinosaur"
    },
    "version": {
      "const": 1
    },
    "fictionalLabCreation": {
      "const": true
    },
    "creation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "speciesId",
        "traits",
        "appearance",
        "modelVersion",
        "runs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,80}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "speciesId": {
          "enum": [
            "compsognathus",
            "gallimimus",
            "stegosaurus",
            "parasaurolophus",
            "triceratops",
            "ankylosaurus",
            "dilophosaurus",
            "velociraptor",
            "pteranodon",
            "brachiosaurus",
            "mosasaurus",
            "spinosaurus",
            "trex",
            "indominus"
          ]
        },
        "traits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tail",
            "legs",
            "mass"
          ],
          "properties": {
            "tail": {
              "type": "number",
              "minimum": 0.6,
              "maximum": 1.6,
              "enum": [
                0.6,
                0.7,
                0.8,
                0.9,
                1,
                1.1,
                1.2,
                1.3,
                1.4,
                1.5,
                1.6
              ]
            },
            "legs": {
              "type": "number",
              "minimum": 0.7,
              "maximum": 1.4,
              "enum": [
                0.7,
                0.8,
                0.9,
                1,
                1.1,
                1.2,
                1.3,
                1.4
              ]
            },
            "mass": {
              "type": "number",
              "minimum": 0.6,
              "maximum": 1.6,
              "enum": [
                0.6,
                0.7,
                0.8,
                0.9,
                1,
                1.1,
                1.2,
                1.3,
                1.4,
                1.5,
                1.6
              ]
            }
          }
        },
        "appearance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "pattern"
          ],
          "properties": {
            "color": {
              "enum": [
                "sample",
                "mint",
                "coral",
                "violet"
              ]
            },
            "pattern": {
              "enum": [
                "plain",
                "spots",
                "stripes"
              ]
            }
          }
        },
        "modelVersion": {
          "const": "genesis-toy-1"
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "speciesId",
              "traits",
              "appearance",
              "conditions",
              "seed",
              "modelVersion",
              "result"
            ],
            "properties": {
              "speciesId": {
                "enum": [
                  "compsognathus",
                  "gallimimus",
                  "stegosaurus",
                  "parasaurolophus",
                  "triceratops",
                  "ankylosaurus",
                  "dilophosaurus",
                  "velociraptor",
                  "pteranodon",
                  "brachiosaurus",
                  "mosasaurus",
                  "spinosaurus",
                  "trex",
                  "indominus"
                ]
              },
              "traits": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tail",
                  "legs",
                  "mass"
                ],
                "properties": {
                  "tail": {
                    "type": "number",
                    "minimum": 0.6,
                    "maximum": 1.6,
                    "enum": [
                      0.6,
                      0.7,
                      0.8,
                      0.9,
                      1,
                      1.1,
                      1.2,
                      1.3,
                      1.4,
                      1.5,
                      1.6
                    ]
                  },
                  "legs": {
                    "type": "number",
                    "minimum": 0.7,
                    "maximum": 1.4,
                    "enum": [
                      0.7,
                      0.8,
                      0.9,
                      1,
                      1.1,
                      1.2,
                      1.3,
                      1.4
                    ]
                  },
                  "mass": {
                    "type": "number",
                    "minimum": 0.6,
                    "maximum": 1.6,
                    "enum": [
                      0.6,
                      0.7,
                      0.8,
                      0.9,
                      1,
                      1.1,
                      1.2,
                      1.3,
                      1.4,
                      1.5,
                      1.6
                    ]
                  }
                }
              },
              "appearance": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color",
                  "pattern"
                ],
                "properties": {
                  "color": {
                    "enum": [
                      "sample",
                      "mint",
                      "coral",
                      "violet"
                    ]
                  },
                  "pattern": {
                    "enum": [
                      "plain",
                      "spots",
                      "stripes"
                    ]
                  }
                }
              },
              "conditions": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "experiment",
                  "track",
                  "turn"
                ],
                "properties": {
                  "experiment": {
                    "enum": [
                      "dash",
                      "balance"
                    ]
                  },
                  "track": {
                    "enum": [
                      "smooth",
                      "grippy",
                      "hurdles"
                    ]
                  },
                  "turn": {
                    "enum": [
                      "gentle",
                      "medium",
                      "sharp"
                    ]
                  }
                }
              },
              "seed": {
                "const": 2718
              },
              "modelVersion": {
                "const": "genesis-toy-1"
              },
              "result": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "seconds",
                  "cleared",
                  "stability",
                  "explanation"
                ],
                "properties": {
                  "seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 30
                  },
                  "cleared": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "stability": {
                    "enum": [
                      "stable",
                      "wobble",
                      "tumble"
                    ]
                  },
                  "explanation": {
                    "type": "string",
                    "maxLength": 240
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
