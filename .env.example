# Copy this file to `.env` and paste your key. `.env` is gitignored and is read
# only by the dev-server middleware in vite.config.ts — it never reaches the
# browser.
#
# Use GENESIS_LAB_ANTHROPIC_KEY rather than the generic ANTHROPIC_API_KEY.
# Vite lets your shell environment override .env values, so if some other
# project exports ANTHROPIC_API_KEY, that key would silently win and this app's
# usage would bill to it. This project-specific name cannot collide.
#
# Restart `npm run dev` after editing. On startup the server prints which key
# it is using (last 4 characters only).

GENESIS_LAB_ANTHROPIC_KEY=sk-ant-api03-...
